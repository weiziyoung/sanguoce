# App routes and trace uploads stay on this origin path.
SANGUOCE_BASE_PATH=/
# Optional full OSS/CDN URL. Include a versioned prefix and trailing slash.
SANGUOCE_ASSET_BASE_URL=
# Production server origin check and persistent trace location.
SANGUOCE_ORIGIN=http://localhost:8080
SANGUOCE_TRACE_DIR=traces/web
# Host directory mounted by Docker Compose; keep it outside release directories.
SANGUOCE_DATA_DIR=../traces
# Existing Docker network shared with your reverse proxy.
SANGUOCE_PROXY_NETWORK=web
